#!name=拼多多去广告 Surge版
#!desc=移除开屏广告、底栏多多视频、会场入口、聊天页面精选推荐及推广，精简首页和个人中心。由可莉 / ZenmoFeiShi 的 Loon 插件 PinDuoDuo_remove_ads.plugin (Moli-X/Tool, 2026-10-02) 改写为 Surge 版：原版用的 Loon 3.5 内置 Rewrite 语法 response.json.delete / response.json.jq / reject_dict 在 Surge 里不存在，改用 http-response JS 实现。
#!author=ZenmoFeiShi, 可莉🅥 (原版) / Surge改写
#!homepage=https://github.com/Moli-X/Tool/blob/X/Loon/Plugin/Kelee/PinDuoDuo_remove_ads.plugin
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png
#!category=去广告

[Rule]
# 关键：先拦 QUIC。原版 Loon 有 AND((DOMAIN,api.pinduoduo.com),(PROTOCOL,QUIC)) REJECT，
# 拼多多走 QUIC/HTTP3 时 MITM 解不开，脚本永远命中不了，底栏就改不动。
# Surge 里用 AND + PROTOCOL,QUIC + REJECT-NO-DROP（不能用 REJECT-DROP，否则 App 不会回落 TCP），
# 逼它回落到 TCP/TLS 再走 MITM。必须放最前面。
# 注意：主配置里 MITM 的“自动拦截 QUIC”也要开着，这条是双保险。
AND,((DOMAIN,api.pinduoduo.com),(PROTOCOL,QUIC)),REJECT-NO-DROP
AND,((DOMAIN,api.yangkeduo.com),(PROTOCOL,QUIC)),REJECT-NO-DROP
# 原版 [Rule] 里 AND((URL-REGEX),(USER-AGENT)) 是 Loon 的复合规则，Surge 不支持 USER-AGENT 条件，拆成下面两条直连 IP 的 URL-REGEX。
# 另外：下面 20 条本来是 [URL Rewrite] 的 reject-dict，实测在 Surge 里没命中
# （manufacturer/cross/shortcut/list 照样 DIRECT 回了 824B，dunkirk 的 url/report 也一样），
# 改成 [Rule] 的 URL-REGEX REJECT，直接在 TCP 层拦，不依赖 MITM 解密和 URL Rewrite。
# [URL Rewrite] 那 20 条已删除：Surge 日志明确说 reject-dict 是无效类型。
URL-REGEX,^https://api\.pinduoduo\.com/api/aristotle/unrated_order_for_unreceived_tab,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/aristotle/query_order_list_tabs_element,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/aquarius/hungary/global/homepage,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/caterham/v3/query/order_express_group,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/search_hotquery,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/zaire_biz/chat/resource/get_list_data,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/caterham/v3/query/new_chat_group,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/alexa/goods/back_up,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/caterham/v3/query/personal,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/brand-olay/goods_detail/bybt_guide,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/engels/reviews/require/append,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/caterham/v3/query/my_order_group,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/caterham/v3/query/likes,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/phantom/gbdbpdv/extra,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/manufacturer/cross/shortcut/list,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/dunkirk/liveactivity/push/create/url/report,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/growth/nagato/app/index/gather,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/engels/wait/receive/review,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/buffon/nasus/recommend,REJECT
URL-REGEX,^https://api\.pinduoduo\.com/api/caterham/v2/query/goods_detail_with_tags,REJECT
URL-REGEX,^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?,REJECT
URL-REGEX,^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?,REJECT
DOMAIN,titan.pinduoduo.com,REJECT
DOMAIN,xg.pinduoduo.com,REJECT
DOMAIN,cdl-1.pddpic.com,REJECT
DOMAIN,cdl-p2.pddpic.com,REJECT
DOMAIN,cd-1.pddpic.com,REJECT
DOMAIN,apm.pinduoduo.com,REJECT
DOMAIN,th-b.pinduoduo.com,REJECT
DOMAIN,ta.pinduoduo.com,REJECT
DOMAIN,th.pinduoduo.com,REJECT
DOMAIN,th-a.pinduoduo.com,REJECT
DOMAIN,ta-a.pinduoduo.com,REJECT
DOMAIN,meta.pinduoduo.com,REJECT
DOMAIN,apm-a.pinduoduo.com,REJECT

# [URL Rewrite] 已删除：Surge 不支持 reject-dict，只支持 header/302/307/reject，
# 那 20 条接口已经改走 [Rule] URL-REGEX REJECT，不需要这里。
[Script]
# 主逻辑：把原版 7 条 response.json.delete / jq 全部放进一个 JS，按 URL 分发。
# 这里拆成 7 条单独的脚本（都指向同一个 JS），不用一条带 | 的合并正则：
# 一是 Surge 的脚本列表里每条都能单独看到、单独开关，出问题好定位；
# 二是避免合并正则在个别 Surge 版本里解析不到。
# script-path 用本仓库的绝对 raw 地址，Surge 从 URL 安装模块后直接能拉到 JS。
PinDuoDuo_homepage = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/api/alexa/homepage/hub, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
PinDuoDuo_search = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/search, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
PinDuoDuo_personal = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/api/philo/personal/hub, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
PinDuoDuo_oak = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/api/oak/integration/render, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
PinDuoDuo_order_detail = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/api/caterham/v3/query/order_detail_group, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
PinDuoDuo_order = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/order/, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
PinDuoDuo_order_list = type=http-response, pattern=^https://api\.(pinduoduo|yangkeduo)\.com/api/aristotle/order_list_v4, script-path=https://raw.githubusercontent.com/onder0402/-api/main/PinDuoDuo_remove_ads_surge.js, requires-body=true, max-size=5242880, timeout=30
# 扫码取件页：原版自带 JS，直接用原作者的远程地址，不用改写
PinDuoDuo_scan = type=http-response, pattern=^https://m\.pinduoduo\.net/mdkd/package\?from_app_scan, script-path=https://raw.githubusercontent.com/Moli-X/Tool/X/Loon/Plugin/Kelee/Script/PinDuoDuo_remove_ads.js, requires-body=true, max-size=5242880, timeout=30

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net
